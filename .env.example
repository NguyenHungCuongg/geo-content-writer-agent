# Sao chép file này thành .env rồi điền giá trị. Không commit .env.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model sinh văn bản (D-02). Chọn khi làm Task 3.
GEMINI_MODEL=
# Model embedding, dùng cho tool dedupe_prompts (Task 4).
GEMINI_EMBED_MODEL=
# Tuỳ chọn: model riêng cho trace analyst của Challenge B (python -m agent.trace_qa), để không
# dùng chung hạn mức free tier với GEMINI_MODEL. Để trống thì dùng GEMINI_MODEL.
TRACE_QA_MODEL=
# Postgres chạy bằng docker compose (Phase 2, Task 1). Tự đặt một mật khẩu cho máy mình,
# chỉ dùng chữ và số (ký tự như @ / # làm hỏng DATABASE_URL bên dưới).
POSTGRES_PASSWORD=
# Tuỳ chọn: cổng trên máy mình, để trống là 5432. Đổi (ví dụ 5433) khi máy đã có Postgres cài sẵn
# chiếm 5432.
POSTGRES_PORT=
# Chuỗi kết nối tới Postgres trên, dạng postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/postgres
# Ghi 127.0.0.1, không ghi localhost: trên Windows localhost thử IPv6 trước, mỗi lần kết nối chậm 5 giây.
# Để trống nếu không chạy Docker: test cần DB sẽ tự skip.
DATABASE_URL=
